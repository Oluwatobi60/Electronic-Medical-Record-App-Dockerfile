# ---- Stage 1: Build the React app ----
FROM node:20-alpine AS builder

WORKDIR /app

COPY eclicnic-frontend/package.json eclicnic-frontend/package-lock.json ./
RUN npm ci

COPY eclicnic-frontend/ ./
RUN npm run build

# ---- Stage 2: Serve with Nginx ----
FROM nginx:alpine

# Remove default config — we'll use the shared config from docker/nginx/
RUN rm /etc/nginx/conf.d/default.conf

# Copy the built React app
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80